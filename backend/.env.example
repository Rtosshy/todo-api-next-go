# Copy to .env.development (for `make run`) or .env (for production)

# App
APP_ENV=development
APP_LOG_FILE=

# Web server
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_CORS_ALLOW_ORIGINS=http://0.0.0.0:8001,http://0.0.0.0:3000,http://localhost:3000,http://localhost:8080

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=api_database
DB_DRIVER=postgres
DB_USER=app
DB_PASSWORD=password
DB_SSL_MODE=disable

# JWT signing key (required, set a strong random value)
SECRET=
