# Copy to .env in this directory before `docker compose up`

# App
APP_ENV=production

# Web server
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_CORS_ALLOW_ORIGINS=http://0.0.0.0:8001,http://0.0.0.0:3000,http://localhost:3000,http://localhost:8080

# Database (DB_HOST must match the postgres service name in compose.yaml)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=api_database
DB_DRIVER=postgres
DB_USER=app
DB_PASSWORD=password
DB_SSL_MODE=disable

# JWT signing key (required, set a strong random value)
SECRET=
